---
import Notice from "../../components/Notice.astro";
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EpisodeCard from "../../components/EpisodeCard.astro";
import { getPublicEpisodes } from "../../lib/content";

const episodes = await getPublicEpisodes();
---

<BaseLayout
  title="Watch — Correlius"
  description="The future home of released Correlius fan films and accessible episode information."
>
  <PageIntro
    eyebrow="Watch"
    title="The Correlius films"
    lead="The Correlius films explore lived experience, mental health, family, and unconventional strength through the journey of Jedi Master Thad Correlius."
  />

  <section class="section section-paper" aria-labelledby="catalog-heading">
    <div class="shell content-stack">
      {
        episodes.length === 0 && (
          <Notice title="Films are being prepared">
            <p>
              No film is being presented as released on this preview. Approved episode
              records, captions, artwork, credits, and playback details must pass review
              before a Watch action appears.
            </p>
          </Notice>
        )
      }

      <div class="section-heading">
        <p class="eyebrow">Fan-film series</p>
        <h2 id="catalog-heading">Correlius Journal</h2>
        <p>
          Set ten years after the Sequel Trilogy, Correlius Journal follows 52-year-old Jedi
          Master Thad Correlius, a former Padawan of Luke Skywalker, as he journals the life
          that comes after an arduous hero’s journey.
        </p>
      </div>

      {
        episodes.length > 0 ? (
          <ol class="episode-grid">
            {episodes.map((episode) => <li><EpisodeCard episode={episode} /></li>)}
          </ol>
        ) : (
          <ul class="card-grid" role="list">
            <li class="info-card">
              <p class="card-number" aria-hidden="true">01</p>
              <h3>Clear release status</h3>
              <p>Only reviewed, playable episodes receive a Watch action.</p>
            </li>
            <li class="info-card">
              <p class="card-number" aria-hidden="true">02</p>
              <h3>Accessible playback</h3>
              <p>Released films require reviewed captions and meaningful non-player context.</p>
            </li>
            <li class="info-card">
              <p class="card-number" aria-hidden="true">03</p>
              <h3>Stable episode pages</h3>
              <p>Each release will have one shareable page with synopsis, credits, and context.</p>
            </li>
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
