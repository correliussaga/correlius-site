---
import Notice from "../../components/Notice.astro";
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Watch — Correlius"
  description="The future home of released Correlius fan films and accessible episode information."
>
  <PageIntro
    eyebrow="Watch"
    title="The Correlius films"
    lead="Released films will appear here in story order with clear playback, caption, and content information."
  />

  <section class="section section-paper" aria-labelledby="catalog-heading">
    <div class="shell content-stack">
      <Notice title="Films are being prepared">
        <p>
          No film is being presented as released on this preview. Approved episode records,
          captions, artwork, credits, and playback details must pass review before a Watch
          action appears.
        </p>
      </Notice>

      <div class="section-heading">
        <p class="eyebrow">Catalog design</p>
        <h2 id="catalog-heading">Built for an expanding story.</h2>
        <p>
          The catalog will keep every episode in a stable reading order without autoplay,
          horizontal carousels, or an account requirement.
        </p>
      </div>

      <ul class="card-grid" role="list">
        <li class="info-card">
          <p class="card-number" aria-hidden="true">01</p>
          <h3>Clear release status</h3>
          <p>Only reviewed, playable episodes receive a Watch action.</p>
        </li>
        <li class="info-card">
          <p class="card-number" aria-hidden="true">02</p>
          <h3>Accessible playback</h3>
          <p>Released films require reviewed captions and meaningful non-player context.</p>
        </li>
        <li class="info-card">
          <p class="card-number" aria-hidden="true">03</p>
          <h3>Stable episode pages</h3>
          <p>Each release will have one shareable page with synopsis, credits, and context.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
