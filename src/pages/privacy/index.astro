---
import Notice from "../../components/Notice.astro";
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy — Correlius"
  description="Preview privacy status for the Correlius public-site implementation."
>
  <PageIntro
    eyebrow="Privacy"
    title="Collect less. Explain what remains."
    lead="The Correlius privacy design minimizes personal information and keeps public measurement separate from partner access."
  />

  <section class="section section-paper">
    <div class="shell section-grid">
      <div>
        <p class="eyebrow">Current preview</p>
        <h2>No advertising trackers or visitor profiles.</h2>
      </div>
      <div class="prose">
        <p>
          Correlius does not use advertising trackers, analytics cookies, session replay,
          visitor profiles, or client-side audience analytics. This static preview does not
          submit personal information or connect public visits to protected partner activity.
        </p>
        <p>
          Cloudflare hosts and protects this site. Like any web host, it processes ordinary
          request and security information such as IP address, request headers, requested path,
          and security events. Correlius uses aggregate edge traffic for routine operations and
          may review limited security information when investigating abuse or failure. It does
          not use ordinary public-visit data to identify or profile visitors.
        </p>
        <p>
          Correlius does not provide a public partner application form and does not collect
          prospective-partner application data through this website. Partner access is offered
          only after private vetting and approval.
        </p>
        <h3>Partner portal</h3>
        <ul>
          <li>The partner portal is hosted separately at partners.correlius.org and protected by Cloudflare Access.</li>
          <li>Approved email addresses are administered privately and are not stored in the public website repository.</li>
          <li>Visiting the sign-in page does not request access, create an account, or add an email address to the approved list.</li>
          <li>Cloudflare processes the authentication and security information needed to protect the portal.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell content-stack">
      <Notice title="Policy approval still required">
        <p>
          This page describes the implementation preview and is not the final privacy
          policy. An effective date and owner-approved privacy contact are still required
          before launch.
        </p>
      </Notice>
    </div>
  </section>
</BaseLayout>
