---
import Notice from "../../components/Notice.astro";
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Support — Correlius"
  description="Learn how future support for the independent Correlius project will be handled safely through its fiscal sponsor."
>
  <PageIntro
    eyebrow="Support"
    title="Help make careful, accessible work possible."
    lead="Support information will explain the project’s needs clearly and send contributions to the approved external fiscal-sponsor page."
  />

  <section class="section section-paper">
    <div class="shell section-grid">
      <div>
        <p class="eyebrow">What support can enable</p>
        <h2>Production with intention.</h2>
      </div>
      <div class="prose">
        <ul class="feature-list">
          <li>Independent film production and post-production</li>
          <li>Captioning and accessible release materials</li>
          <li>Reviewed public and professional resources</li>
          <li>Secure, low-maintenance project infrastructure</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell content-stack">
      <Notice title="Contribution link not yet available">
        <p>
          The production Fractured Atlas URL and final fiscal-sponsorship wording are still
          awaiting approval. Correlius does not collect card or bank details on this site,
          and no placeholder contribution link is active.
        </p>
      </Notice>
    </div>
  </section>
</BaseLayout>
