---
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="For Partners — Correlius"
  description="Sign in to the secure Correlius portal for privately vetted and approved partners."
>
  <PageIntro
    eyebrow="For Partners"
    title="A secure portal for vetted partners."
    lead="Correlius does not accept partner applications online. Access is limited to individually approved partners and protected through authenticated access controls."
  />

  <section class="section section-paper" aria-labelledby="partner-access-heading">
    <div class="shell section-grid">
      <div>
        <p class="eyebrow">Private access</p>
        <h2 id="partner-access-heading">Partner access is by invitation only.</h2>
      </div>
      <div class="prose">
        <p>
          <strong>partners.correlius.org</strong> is the secure portal for approved Correlius
          partners. The portal is protected by authenticated access controls and is not a public
          registration or application system.
        </p>
        <p>
          Only privately approved email addresses can sign in. Visiting the portal
          does not request access, create an account, or add an email address to the approved
          partner list.
        </p>
        <p>
          <a class="button button-primary" href="https://partners.correlius.org/">
            Partner sign-in
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
