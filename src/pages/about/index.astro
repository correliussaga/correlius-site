---
import Notice from "../../components/Notice.astro";
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProject } from "../../lib/content";

const project = await getProject();
---

<BaseLayout
  title="About — Correlius"
  description="An introduction to the purpose and themes of the independent Correlius fan-film project."
>
  <PageIntro
    eyebrow="About"
    title={project.missionHeading}
    lead={project.heroSummary}
  />

  <section class="section section-paper">
    <div class="shell section-grid">
      <div>
        <p class="eyebrow">Project purpose</p>
        <h2>More than winning the fight.</h2>
      </div>
      <div class="prose">
        {project.missionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <ul class="tag-list" aria-label="Project themes">
          {project.themes.map((theme) => <li>{theme}</li>)}
        </ul>
        <p><a class="text-link" href="/watch/">Explore the film catalog <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell content-stack">
      <Notice title="Biography and history pending review">
        <p>
          The creator biography, project chronology, photographs, credits, and final
          legal-language references will be added only after their source material is
          approved.
        </p>
      </Notice>
    </div>
  </section>
</BaseLayout>
