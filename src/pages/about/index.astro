---
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProject } from "../../lib/content";

const project = await getProject();
---

<BaseLayout
  title="About — Correlius"
  description="An introduction to the purpose and themes of the independent Correlius fan-film project."
>
  <PageIntro
    eyebrow="About"
    title={project.missionHeading}
    lead={project.heroSummary}
  />

  <section class="section section-paper">
    <div class="shell section-grid">
      <div>
        <p class="eyebrow">Project purpose</p>
        <h2>A different lens on a familiar galaxy.</h2>
      </div>
      <div class="prose">
        {project.missionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <ul class="tag-list" aria-label="Project themes">
          {project.themes.map((theme) => <li>{theme}</li>)}
        </ul>
        <p><a class="text-link" href="/watch/">Explore the film catalog <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell section-grid">
      <div>
        <p class="eyebrow">About the Creator</p>
        <img
          class="creator-portrait"
          src="/images/brian-payne.jpg"
          alt="Portrait of Brian Payne"
          width="958"
          height="960"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="prose">
        <p>
          Brian Payne is the creator of Correlius, a nonprofit Star Wars fan-story project
          centered on Black lived experience, mental health, family, healing, and community.
          A lifelong Star Wars fan, Brian brings more than 25 years of corporate experience,
          including work in quality engineering and artificial intelligence.
        </p>
        <p>
          Outside of technology, Brian has a long background in music and performance,
          spanning classical piano, jazz, R&amp;B, gospel and music production. His experience
          includes performing at major cultural and international events, working with
          national recording artists, and producing music that has received national radio
          exposure.
        </p>
        <p>
          Correlius brings those worlds together: technical problem-solving, performance,
          music, and a lifelong love of science fiction. Brian created the project as an
          independent, nonprofit storytelling effort designed to use familiar mythology in
          new ways, particularly to explore Black male mental health and culturally resonant
          stories for the Blerd community.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
