---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found — Correlius"
  description="The requested Correlius page could not be found."
>
  <section class="page-intro not-found">
    <div class="shell page-intro-inner">
      <p class="eyebrow">404 · Page not found</p>
      <h1>This path has gone quiet.</h1>
      <p class="page-lead">
        The page may have moved, or the address may be incomplete. Return home or explore
        the film catalog.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/">Return home</a>
        <a class="button button-secondary" href="/watch/">Go to Watch</a>
      </div>
    </div>
  </section>
</BaseLayout>
