---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProject, getPublicEpisodes } from "../lib/content";

const project = await getProject();
const publicEpisodes = await getPublicEpisodes();
const featuredEpisode = publicEpisodes.find(
  ({ data }) => data.status === "released" && data.featured,
);
---

<BaseLayout
  title="Correlius — An Independent Fan-Film Project"
  description="Discover Correlius, an independent nonprofit fan-film project centered on character, healing, family, and unconventional strength."
>
  <section class="hero">
    <div class="shell hero-inner">
      <p class="eyebrow">{project.descriptor}</p>
      <h1>{project.heroHeading}</h1>
      <p class="hero-copy">
        {project.heroSummary}
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/watch/">Explore the films</a>
        <a class="button button-secondary" href="/about/">About the project</a>
      </div>
    </div>
  </section>
</BaseLayout>
