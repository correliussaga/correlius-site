---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProject, getPublicEpisodes } from "../lib/content";

const project = await getProject();
const publicEpisodes = await getPublicEpisodes();
const featuredEpisode = publicEpisodes.find(
  ({ data }) => data.status === "released" && data.featured,
);
---

<BaseLayout
  title="Correlius — An Independent Fan-Film Project"
  description="Discover Correlius, an independent nonprofit fan-film project centered on character, healing, family, and unconventional strength."
>
  <section class="hero">
    <div class="shell hero-inner">
      <p class="eyebrow">{project.descriptor}</p>
      <h1>{project.heroHeading}</h1>
      <p class="hero-copy">
        {project.heroSummary}
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/watch/">Explore the films</a>
        <a class="button button-secondary" href="/about/">About the project</a>
      </div>
    </div>
  </section>

  <section class="section section-paper" aria-labelledby="current-status-heading">
    <div class="shell section-grid">
      <div>
        <p class="eyebrow">Public site preview</p>
        <h2 id="current-status-heading">
          {featuredEpisode ? "A featured film is ready." : "The next chapter is being prepared."}
        </h2>
      </div>
      <div class="prose">
        <p>{featuredEpisode ? featuredEpisode.data.shortSynopsis : project.availabilityMessage}</p>
        <p>
          Nothing here requires an account, and unfinished material is never presented as
          released.
        </p>
        {
          featuredEpisode && (
            <p>
              <a class="text-link" href={`/watch/${featuredEpisode.data.slug}/`}>
                Watch {featuredEpisode.data.title} <span aria-hidden="true">→</span>
              </a>
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
