---
interface Props {
  customerCode: string;
  poster: {
    src: string;
    width: number;
    height: number;
  };
  streamUid: string;
  title: string;
}

const { customerCode, poster, streamUid, title } = Astro.props;
const source = `https://customer-${customerCode}.cloudflarestream.com/${streamUid}/iframe`;
---

<section class="player-section" aria-labelledby="player-heading">
  <h2 id="player-heading">Watch {title}</h2>
  <div class="player-frame" data-stream-player data-player-src={source}>
    <img
      class="player-poster"
      src={poster.src}
      alt=""
      width={poster.width}
      height={poster.height}
      decoding="async"
    />
    <button
      class="player-load-button"
      type="button"
      data-stream-load
      data-player-title={`Stream player for ${title}`}
      aria-describedby="player-privacy-note"
    >
      Load video player
    </button>
  </div>
  <p class="player-help" id="player-privacy-note" data-stream-status aria-live="polite">
    The Cloudflare Stream player loads only after you choose it, and playback does not start
    automatically. If the player is unavailable, the synopsis and episode information remain
    available below.
  </p>
</section>

<script is:inline src="/scripts/stream-player.js" defer></script>
