---
const { currentPath = "/" } = Astro.props;

const navigation = [
  { href: "/", label: "Home" },
  { href: "/watch/", label: "Watch" },
  { href: "/about/", label: "About" },
  { href: "/support/", label: "Support" },
  { href: "/for-partners/", label: "For Partners" },
];

const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Correlius home">
      <span class="wordmark-mark" aria-hidden="true">C</span>
      <span>CORRELIUS</span>
    </a>

    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-button
    >
      <span data-menu-label>Menu</span>
    </button>

    <nav
      id="primary-navigation"
      class="site-navigation"
      aria-label="Primary navigation"
      data-site-navigation
    >
      {
        navigation.map(({ href, label }) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline src="/scripts/navigation.js" defer></script>
