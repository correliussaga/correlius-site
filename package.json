{
  "name": "correlius-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1",
    "npm": ">=10.8.1 <11"
  },
  "scripts": {
    "build": "npm run check && astro build && npm run verify:build && npm run verify:shell",
    "check": "astro check",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "npm run test:scanner && npm run build",
    "test:scanner": "node scripts/verify-build.mjs --self-test",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:shell": "node scripts/verify-public-shell.mjs"
  },
  "dependencies": {
    "astro": "7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
